# STATE_BUCKET_NAME (Pulumi state bucket, created by `k3s: First-time setup
# (AWS)`) is deliberately not committed here — it ties to the AWS account.
# Locally it goes in .env.secrets (gitignored); in CI it's the
# STATE_BUCKET_NAME GitHub Secret.
CLUSTER_NAME=campaign-setting-query-engine
DEFAULT_NODE_COUNT=1
GPU_NODE_COUNT=1
DISK_SIZE_GB=60
PORTS=80,443
ELASTIC_IP_COUNT=1
