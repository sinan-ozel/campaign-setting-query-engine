# LLM provider secrets for integration tests.
# Copy this file to tests/.env and fill in the key for whichever
# provider is active in config/llm.yaml.
#
# Any ${VAR} reference in config/llm.yaml is resolved from this file.

# llama.cpp (local GPU)
LLAMA_CPP_HOST=http://host.docker.internal:8080/v1

# Mistral API
MISTRAL_API_KEY=

# Anthropic API
ANTHROPIC_API_KEY=

# OpenAI API
OPENAI_API_KEY=
